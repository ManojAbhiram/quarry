# ──────────────────────────────────────────────────────────────────────────────
# Quarry backend — environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit a real `.env`. Replace every "your_..._here" placeholder below.
# Values shown for non-secret settings are the built-in defaults — uncomment to
# override. Leaving them unset keeps the current behaviour.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# SECRET_KEY is REQUIRED — generate one with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file by default (created automatically). Any SQLAlchemy async URL works, e.g.
# postgresql+asyncpg://user:pass@localhost/quarry
DATABASE_URL=sqlite+aiosqlite:///./quarry.db

# ── Auth rate limiting (attempts per client address and endpoint within the window) ───────
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── LiteLLM (required) ────────────────────────────────────────────────────────
# LITELLM_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
# LITELLM_MODEL_MINI=openrouter/meta-llama/llama-3.1-8b-instruct
# LITELLM_FALLBACK_MODELS=groq/llama-3.3-70b-versatile

# ── Serper — Google Search (required) ────────────────────────────────────────
SERPER_API_KEY=your_serper_api_key_here

# ── Provider API keys for LiteLLM (set the ones you use) ─────────────────────
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── SMTP (password reset emails) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Gmail: SMTP_USERNAME must be the FULL address (you@gmail.com), and SMTP_PASSWORD a 16-char
# App Password (needs 2-Step Verification). Port 587 = STARTTLS, 465 = SSL.
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM=Quarry <you@gmail.com>

# ── Frontend URL (reset-password redirect link) ──────────────────────────────
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=15

# ── Scraping / pipeline limits (optional — defaults shown) ───────────────────
# SCRAPE_TIMEOUT=15
# MAX_LEADS_TO_PROCESS=40

# ── LLM call tuning (optional — defaults shown) ──────────────────────────────
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT=30
# LLM_CONCURRENCY=12

# ── Scoring thresholds (optional — defaults shown) ───────────────────────────
# ICP_SCORE_THRESHOLD=60
# INTENT_SCORE_DECAY_RATE=0.15
# INTENT_SCORE_DECAY_PERIOD_DAYS=30

# --- Phase 3 (outreach, integrations, watch, enrichment) ---
PUBLIC_API_URL=http://localhost:8000
P3_SCHEDULER=true
OUTREACH_BOUNCE_PAUSE_THRESHOLD=0.02
OUTREACH_BOUNCE_MIN_SAMPLE=20
ENRICH_FREE_CREDITS=100
HUNTER_API_KEY=
SNOV_API_KEY=
PDL_API_KEY=
CLAUDE_BATCH_SCORING=false
CLAUDE_SCORING_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
