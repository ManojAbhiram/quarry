# Production environment template for the Quarry API (read by docker-compose.yml via env_file).
# Copy to .env.production and fill in. NEVER commit the real file. Everything below is a placeholder.
# Values shown for optional settings are the built-in defaults.

# ── Required ──────────────────────────────────────────────────────────────────
# The API refuses to start without these two.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
SERPER_API_KEY=your_serper_api_key_here

# ── URLs and cookies ──────────────────────────────────────────────────────────
# Where users open the web app (used for redirects, invite and reset links, CORS default).
FRONTEND_URL=http://localhost:8080
# Public base URL of the API (used in outreach unsubscribe links and tracking). Behind the bundled nginx this is
# the same origin as the web app.
PUBLIC_API_URL=http://localhost:8080
# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8080
# Cookies: Secure defaults to true when FRONTEND_URL is https. Set it to true on any https deployment.
COOKIE_SECURE=false
# lax is right when the web app and API share a site (the bundled nginx does). "none" is only for cross-site and forces Secure.
COOKIE_SAMESITE=lax
# Set to share cookies across sibling subdomains, e.g. .example.com. Leave empty otherwise.
COOKIE_DOMAIN=
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=7
# PASSWORD_RESET_EXPIRE_MINUTES=15
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ── Database ──────────────────────────────────────────────────────────────────
# docker-compose.yml pins this to the persistent volume at /data. Schema migrations run automatically at startup.
# DATABASE_URL=sqlite+aiosqlite:////data/quarry.db

# ── LLM (set the key(s) for the provider(s) you use) ──────────────────────────
# LITELLM_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
# LITELLM_MODEL_MINI=openrouter/meta-llama/llama-3.1-8b-instruct
# LITELLM_FALLBACK_MODELS=groq/llama-3.3-70b-versatile
# LLM_CONCURRENCY=12
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT=30
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROK_API_KEY=
# CLAUDE_SCORING_MODEL=claude-haiku-4-5

# ── Google sign-in (optional) ─────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback

# ── Outgoing email: password reset and team invites (optional) ────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Quarry <no-reply@example.com>

# ── Billing (optional; leave blank to disable checkout) ───────────────────────
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_TEAM=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_PRO=
# RAZORPAY_PLAN_TEAM=

# ── HubSpot CRM (optional) ────────────────────────────────────────────────────
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URI=https://your-domain.example/integrations/hubspot/callback

# ── Usage, quotas and cost estimates ──────────────────────────────────────────
# QUOTA_RUNS_PER_MONTH=30
# QUOTA_COST_USD_PER_MONTH=20
# SERPER_USD_PER_CALL=0.001
# LLM_USD_PER_CALL=0.002
# ENRICH_FREE_CREDITS=100

# ── Pipeline tuning ───────────────────────────────────────────────────────────
# MAX_LEADS_TO_PROCESS=40
# ICP_SCORE_THRESHOLD=60
# ICP_FILTER_ENABLED=false
# INTENT_SCORE_DECAY_RATE=0.15
# INTENT_SCORE_DECAY_PERIOD_DAYS=30
# SCRAPE_TIMEOUT=15
# ENABLE_PLAYWRIGHT=false
# ENABLE_LINKEDIN_ENRICHMENT=true
# ENABLE_SIGNAL_ENRICHMENT=true
# LINKEDIN_ENRICH_MAX_LEADS=50
# SIGNAL_ENRICH_MAX_LEADS=25
# ENRICH_CONCURRENCY=6
# CAREERS_MAX_ROLES=15
# CAREERS_ENRICH_TIMEOUT=30
# CAREERS_JOB_TTL_DAYS=14
# CAREERS_RECENCY_DAYS=90
# CAREERS_MIN_DICT_TECHS=3
# CAREERS_PIPELINE_EXPORT=true
# TECH_FUSION_THRESHOLD=0.50

# ── Background jobs and schedulers ────────────────────────────────────────────
# JOB_WORKER_CONCURRENCY=4
# JOB_POLL_INTERVAL_SECONDS=1.0
# JOB_MAX_ATTEMPTS=3
# JOB_BACKOFF_BASE_SECONDS=5
# JOB_BACKOFF_MAX_SECONDS=300
# P3_SCHEDULER_INTERVAL=60
# OUTREACH_BOUNCE_PAUSE_THRESHOLD=0.02
# OUTREACH_BOUNCE_MIN_SAMPLE=20
